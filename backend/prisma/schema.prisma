generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  NURSE
  SPECIALIST
  PATIENT
  ADMIN
}

enum Sex {
  F
  M
}

enum ConsultationStatus {
  DRAFT
  PENDING_AI
  AI_COMPLETED
  PENDING_SPECIALIST_REVIEW
  SPECIALIST_COMPLETED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

enum EarSide {
  LEFT
  RIGHT
  BOTH
}

enum ClinicalReferenceType {
  SYMPTOM
  MEDICAL_HISTORY
  TOUCH_CHECK
}

enum ExpertiseStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

model User {
  id              String   @id @default(uuid())
  fullName        String
  email           String   @unique
  passwordHash    String
  role            Role
  phone           String?
  healthFacility  String?
  professionalId  String?
  linkedPatientId String?
  createdAt       DateTime @default(now())

  patientProfile        Patient?       @relation("PatientAccount")
  createdPatients       Patient[]      @relation("PatientCreator")
  consultationsCreated  Consultation[] @relation("ConsultationCreator")
  consultationsAssigned Consultation[] @relation("ConsultationSpecialist")
  expertiseRequested    ExpertiseRequest[] @relation("ExpertiseRequester")
}

model Patient {
  id                      String   @id @default(uuid())
  userId                  String?  @unique
  createdByUserId         String
  firstName               String
  lastName                String
  birthDate               String?
  sex                     Sex?
  phone                   String?
  address                 String?
  consentForAi            Boolean  @default(false)
  consentForTeleExpertise Boolean  @default(false)
  isValidated             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  account       User?          @relation("PatientAccount", fields: [userId], references: [id])
  creator       User           @relation("PatientCreator", fields: [createdByUserId], references: [id])
  consultations Consultation[]
}

model Consultation {
  id                   String             @id @default(uuid())
  externalAiCaseId     String?
  patientId            String
  createdByUserId      String
  assignedSpecialistId String?
  earSide              EarSide            @default(BOTH)
  symptomIds           String[]
  symptomLabels        String[]
  medicalHistoryIds    String[]
  medicalHistoryLabels String[]
  touchCheckIds        String[]
  touchCheckLabels     String[]
  touchObservations    Json?
  clinicalNotes        String?
  clinicalNarrative    String
  status               ConsultationStatus @default(DRAFT)
  urgency              UrgencyLevel       @default(MEDIUM)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  patient            Patient            @relation(fields: [patientId], references: [id])
  creator            User               @relation("ConsultationCreator", fields: [createdByUserId], references: [id])
  assignedSpecialist User?              @relation("ConsultationSpecialist", fields: [assignedSpecialistId], references: [id])
  otoscopicImages    OtoscopicImage[]
  aiResponse         AiResponse?
  expertiseRequest   ExpertiseRequest?
}

model OtoscopicImage {
  id             String   @id @default(uuid())
  consultationId String
  earSide        EarSide
  mimeType       String
  fileName       String?
  byteSize       Int?
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model AiResponse {
  id               String   @id @default(uuid())
  consultationId   String   @unique
  rawJson          Json
  imageOpinion     String?
  ragOpinion       String?
  likelyDiagnosis  String?
  confidenceLabel  String?
  warnings         String[]
  sources          String[]
  createdAt        DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model ExpertiseRequest {
  id                String          @id @default(uuid())
  consultationId    String          @unique
  requestedByUserId String
  assignedToUserId  String?
  status            ExpertiseStatus @default(PENDING)
  diagnosis         String?
  recommendation    String?
  specialistNotes   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  requester    User         @relation("ExpertiseRequester", fields: [requestedByUserId], references: [id])
}

model ClinicalReferenceItem {
  id          String                @id @default(uuid())
  type        ClinicalReferenceType
  label       String
  description String?
  isActive    Boolean               @default(true)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([type, isActive])
}
