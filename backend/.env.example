# development | test | production (production : contrôles de sécurité au démarrage)
NODE_ENV=development
PORT=4000
# Origines autorisées, séparées par des virgules. « * » accepté en développement uniquement.
CORS_ORIGIN=http://localhost:3000
# Secrets JWT : obligatoires, distincts, aléatoires (32 caractères minimum en production).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
# Comptes de démonstration : créés par défaut en développement seulement (true/false pour forcer).
# SEED_DEMO=false
# Nombre de proxys de confiance devant l'API (0 en local, 1 derrière un reverse proxy).
TRUST_PROXY=0
# Service FastAPI Deep4ORL — URL ngrok (pas localhost:8000 en prod/dev distant)
# Exemple : https://abc123.ngrok-free.app  (sans slash final)
AI_SERVICE_BASE_URL=https://VOTRE-SOUS-DOMAINE.ngrok-free.app
AI_SERVICE_TIMEOUT_MS=120000
# Photos du tympan chiffrées sur le serveur (AES-256-GCM). Clé de 32 octets en base64, à garder
# précieusement : sans elle, les photos stockées sont perdues.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IMAGE_ENCRYPTION_KEY=
# Dossier des photos chiffrées (relatif au dossier backend, exclu du dépôt).
IMAGE_STORAGE_DIR=storage/otoscopic-images
# PostgreSQL uniquement (le schéma utilise des listes, non prises en charge par SQLite)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/korai_dev
