# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner .env.

# Obligatoire : clé de l'API Mistral AI (https://console.mistral.ai)
MISTRAL_API_KEY=

# Modèle selon l'abonnement Mistral : mistral-large-latest n'est pas inclus dans tous les abonnements
# (sinon par exemple ministral-14b-latest). Délai d'un appel (secondes) et nouvelles tentatives.
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TIMEOUT_S=40
MISTRAL_MAX_RETRIES=1

# Jeton partagé avec le backend Korai (AI_SERVICE_API_KEY dans son .env). Défini : exigé sur toutes
# les routes sauf /, /health et /docs. Vide : service ouvert, seulement en local sur 127.0.0.1.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_API_TOKEN=

# Cas gardés en mémoire pour la validation et l'export (0 = aucun : Korai garde ses propres dossiers)
CASE_HISTORY_SIZE=500
# Taille maximale d'une image envoyée (Mo)
MAX_UPLOAD_MB=10

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Inutile derrière le proxy nginx de docker-compose. Ne pas mettre * en production.
ALLOWED_ORIGINS=http://localhost:5173

# Hôte et port quand on lance `python utils/rag_api.py`
API_HOST=127.0.0.1
API_PORT=8000

# Google Drive (facultatif) : stockage des images, validations et dataset
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# true = les images déposées sont lisibles par toute personne ayant le lien (déconseillé)
GOOGLE_DRIVE_PUBLIC_LINKS=false

# Hugging Face (facultatif) : seulement si le téléchargement du modèle d'embeddings l'exige
HF_TOKEN=
