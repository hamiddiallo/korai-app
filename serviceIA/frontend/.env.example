# Copier en .env.local (développement). Ne jamais versionner les fichiers .env*.

# URL du backend. En développement, laisser vide : le proxy Vite redirige /api vers http://localhost:8000.
# Avec docker-compose, l'image est construite avec VITE_API_URL=/api (proxy nginx).
VITE_API_URL=

# Supabase (facultatif) : persistance des consultations côté serveur
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
